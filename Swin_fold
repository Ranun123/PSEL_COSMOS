def depth_image(x,y,p, x_loc, y_loc, H_r=8, W_theta=32,low_q=0.2,high_q=0.8,device="cpu"):
    x = np.asarray(x, dtype=float)
    y = np.asarray(y, dtype=float)
    p = np.asarray(p, dtype=float)

    cx, cy = x.mean(), y.mean()
    dx = x - cx
    dy = y - cy

    r = np.sqrt(dx ** 2 + dy ** 2)  # [256]
    theta = np.arctan2(dy, dx)  # [-pi, pi]
    theta[theta < 0] += 2 * np.pi

    r_max = r.max() + 1e-6
    r_norm = r / r_max  # [0, 1]
    theta_norm = theta / (2 * np.pi)

    r_idx = np.clip((r_norm * H_r).astype(int), 0, H_r - 1)
    t_idx = np.clip((theta_norm * W_theta).astype(int), 0, W_theta - 1)

    p_mean = p.mean()
    p_std = p.std() + 1e-6
    p_z = (p - p_mean) / p_std

    grid = np.zeros((H_r, W_theta), dtype=float)
    count = np.zeros((H_r, W_theta), dtype=float)

    for ri, ti, v in zip(r_idx, t_idx, p_z):
        grid[ri, ti] += v
        count[ri, ti] += 1.0

    grid[count > 0] /= count[count > 0]

    gy, gx = np.gradient(grid)  # gy: d/dr, gx: d/dtheta
    grad_mag = np.sqrt(gx ** 2 + gy ** 2)

    low_thr = np.quantile(grid, low_q)
    high_thr = np.quantile(grid, high_q)

    low_mask = (grid <= low_thr).astype(float)
    high_mask = (grid >= high_thr).astype(float)

    x_loc = np.asarray(x_loc, dtype=float)
    y_loc = np.asarray(y_loc, dtype=float)

    dx_loc = x_loc - cx
    dy_loc = y_loc - cy

    r_loc = np.sqrt(dx_loc ** 2 + dy_loc ** 2)
    theta_loc = np.arctan2(dy_loc, dx_loc)
    theta_loc[theta_loc < 0] += 2 * np.pi

    r_loc_norm = r_loc / r_max  # 0~1
    theta_loc_norm = theta_loc / (2 * np.pi)

    r_loc_idx = np.clip((r_loc_norm * H_r).astype(int), 0, H_r - 1)
    t_loc_idx = np.clip((theta_loc_norm * W_theta).astype(int), 0, W_theta - 1)

    K = len(x_loc)
    loc_masks = np.zeros((K, H_r, W_theta), dtype=float)

    grid_t = torch.from_numpy(grid.astype("float32")).to(device)
    grad_t = torch.from_numpy(grad_mag.astype("float32")).to(device)
    low_t = torch.from_numpy(low_mask.astype("float32")).to(device)
    high_t = torch.from_numpy(high_mask.astype("float32")).to(device)
    loc_t = torch.from_numpy(loc_masks.astype("float32")).to(device)  # [K, H_r, W_theta]

    input_tensor = torch.cat(
        [
            grid_t.unsqueeze(0),  # [1, H_r, W_theta]
            grad_t.unsqueeze(0),  # [1, ...]
            low_t.unsqueeze(0),
            high_t.unsqueeze(0),
            loc_t,  # [K, ...]
        ],
        dim=0
    )

    return input_tensor

