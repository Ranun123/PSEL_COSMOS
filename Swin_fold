p_swin_oof = np.zeros(len(train_Y))       # OOF prob (train용)
p_swin_test = np.zeros(len(test_X))       # test prob (fold-avg)

for fold, (tr_idx, val_idx) in enumerate(kf_swin.split(np.zeros(len(train_Y)), train_Y), 1):
    print(f"\n===== Swin Fold {fold} =====")

    # --------- fold별 dataset / loader ---------
    train_d = Subset(dataset, tr_idx)
    val_d = Subset(dataset, val_idx)

    # fold별 클래스 가중 샘플러
    fold_labels = train_Y.values[tr_idx]
    class_sample_counts = np.bincount(fold_labels)
    weights = 1.0 / class_sample_counts
    sample_weights = np.array([weights[l] for l in fold_labels])

    sampler = WeightedRandomSampler(
        weights=sample_weights,
        num_samples=len(sample_weights),
        replacement=True,
    )

    train_loader = DataLoader(train_d, batch_size=64, sampler=sampler)
    val_loader   = DataLoader(val_d, batch_size=64, shuffle=False)

    # --------- Swin 모델 새로 생성 ---------
    model = SwinTransformer(in_chans=4+K).to(device)

    # backbone만 freeze (네가 쓰던 전략 그대로)
    # for p in model.backbone.parameters():
    #     p.requires_grad = False
    #
    # for p in model.backbone.layers[-1].parameters():
    #     p.requires_grad = True

    # loss / optimizer / scheduler / early stopping
    criterion = nn.BCEWithLogitsLoss(
        pos_weight=torch.tensor([5.7], dtype=torch.float32).to(device)
    )

    num_epochs = 35
    optimizer = torch.optim.AdamW(
        [
            {"params": model.backbone.layers.parameters(), "lr": 1e-6},
            {"params": model.coord_mlp.parameters(), "lr": 1e-2},
            {"params": model.classifier.parameters(), "lr": 1e-3},
        ],
        weight_decay=0.05,
    )

    num_training_steps = num_epochs * len(train_loader)
    scheduler = get_cosine_schedule_with_warmup(
        optimizer,
        num_warmup_steps=int(0.1 * num_training_steps),
        num_training_steps=num_training_steps,
    )

    early_stopping = EarlyStopping(
        patience=10,
        mode="max",
        delta=1e-4,
        path=f"best_swin_fold{fold}.pth",
    )

    # --------- 학습 루프 ---------
    for epoch in range(1, num_epochs + 1):
        model.train()
        total_loss = 0.0

        for images, g_batch, labels in train_loader:
            images = images.to(device)
            g_batch = g_batch.to(device)
            labels = labels.to(device)

            optimizer.zero_grad()
            logits = model(images, g_batch)
            loss = criterion(logits, labels)

            loss.backward()
            optimizer.step()
            scheduler.step()

            total_loss += loss.item() * images.size(0)

        mean_loss = total_loss / len(train_d)
        train_p, train_l = get_predictions(train_loader, model, device)
        val_p, val_l = get_predictions(val_loader, model, device)

        train_auc = roc_auc_score(train_l, train_p)
        val_auc   = roc_auc_score(val_l, val_p)
        print(
            f"Fold {fold} | Epoch {epoch:02d} | "
            f"loss={mean_loss:.4f} | train_auc={train_auc:.4f} | val_auc={val_auc:.4f}"
        )

        early_stopping(val_auc, model)
        if early_stopping.early_stop:
            print(f"Early stopping at epoch {epoch}")
            break

    # --------- best 모델 로드 후 fold 예측 ---------
    best_model_path = f"best_swin_fold{fold}.pth"
    model.load_state_dict(torch.load(best_model_path, map_location=device))
    model.to(device)
    model.eval()

    # fold의 val 구간에 대한 확률 → OOF에 채우기
    val_p, val_l = get_predictions(val_loader, model, device)
    p_swin_oof[val_idx] = val_p

    # test 셋에 대한 확률 → fold-avg
    test_p, _ = get_predictions(test_loader, model, device)
    p_swin_test += test_p / n_splits

# --------- Swin OOF AUC 확인 ---------
