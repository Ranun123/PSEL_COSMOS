class SwinTransformer(nn.Module):
    def __init__(self, img_size=32, coord_dim=4, coord_emb_dim=96, in_chans=4+K):
        super().__init__()
        self.img_size = img_size

        self.backbone = timm.create_model(
            'swin_tiny_patch4_window7_224',
            pretrained=True,
            in_chans=in_chans,
            num_classes=0,  # head 제거 → feature만 뽑음
            global_pool="avg",
            img_size=img_size,
        )
        backbone_dim = self.backbone.num_features

        self.coord_mlp = nn.Sequential(
            nn.Linear(coord_dim, coord_emb_dim),
            nn.ReLU(),
            # nn.BatchNorm1d(coord_emb_dim),
        )

        self.classifier = nn.Sequential(
            nn.Linear(backbone_dim + coord_emb_dim, 128),
            nn.ReLU(),
            nn.Dropout(0.1),
            nn.Linear(128, 1),
        )

    def forward_features(self, x, loc):
        if x.shape[-1] != self.img_size or x.shape[-2] != self.img_size:
            x = F.interpolate(
                x,
                size=(self.img_size, self.img_size),
                mode="bilinear",
                align_corners=False,
            )  # [B, C, 32, 32]

        img_feat = self.backbone(x)  # [B, backbone_dim]  (이미지 임베딩)
        loc_feat = self.coord_mlp(loc)

        fused_feat = torch.cat([img_feat, loc_feat], dim=1)  # [B, backbone_dim+coord_emb_dim]
        return fused_feat

    def forward(self, x, loc):
        feat = self.forward_features(x, loc)
        logit = self.classifier(feat)
        return logit.squeeze(1)   #[B]

